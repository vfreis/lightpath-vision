{
  "name": "lightpath-vision",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "workspaces": ["frontend", "api"],
  "scripts": {
    "prebuild": "npm install --include=dev",
    "build": "npm --workspace frontend run build && npm --workspace @lightpath/braciera-vision-api run build",
    "start": "node api/dist/src/server.js",
    "test": "npm --workspace @lightpath/braciera-vision-api test",
    "typecheck": "npm --workspace @lightpath/braciera-vision-api run typecheck",
    "check": "npm run typecheck && npm run test && npm run build",
    "eval:run": "node scripts/run-evals-public.mjs",
    "eval:calibration:collect": "npm --workspace @lightpath/braciera-vision-api run build && node scripts/run-calibration-evals.mjs",
    "eval:calibrate": "node scripts/calibrate-evals.mjs"
  }
}
