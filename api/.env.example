# Required for POST /api/v1/analyze. Never expose this value through VITE_* or frontend code.
OPENAI_API_KEY=

# Pinned recognition baseline. Change only with the same versioned eval set.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000

# Allowed browser origins. For Hostinger single-domain deploy, set this to the exact temporary HTTPS origin.
ALLOWED_ORIGINS=http://localhost:5173

# Optional override for the canonical menu JSON.
MENU_CATALOG_PATH=

# Upload/runtime guardrails.
MAX_UPLOAD_MB=8
MAX_IMAGE_EDGE=1600
MAX_REFERENCE_IMAGES=8
RATE_LIMIT_PER_MINUTE=20

# Recognition acceptance thresholds/margins live in data/abstention-policy.json and are marked pending_eval until calibrated.

# Hostinger Node.js Web Apps expect port 3000.
PORT=3000
NODE_ENV=production
