# Required for POST /api/v1/analyze. Never expose this value through VITE_* or frontend code.
OPENAI_API_KEY=

# Same model currently used by Dermaly.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=30000

# Allowed browser origins. For Hostinger single-domain deploy, set this to the exact temporary HTTPS origin.
ALLOWED_ORIGINS=http://localhost:5173

# Optional override for the canonical menu JSON.
MENU_CATALOG_PATH=

# Upload / decision guardrails.
MAX_UPLOAD_MB=8
MAX_IMAGE_EDGE=1600
MAX_REFERENCE_IMAGES=8
MATCH_THRESHOLD=0.78
MIN_TOP_MARGIN=0.10
RATE_LIMIT_PER_MINUTE=20

# Hostinger Node.js Web Apps expect port 3000.
PORT=3000
NODE_ENV=production
