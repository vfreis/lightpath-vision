# Required for POST /api/v1/analyze. Never expose this value through VITE_* or frontend code.
# In Hostinger, add this manually in Website > Environment variables. Do not commit a populated .env.
OPENAI_API_KEY=

# Current low-cost multimodal default; override without code changes if needed.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=30000

# GitHub Pages origin. Origins only: no path suffix.
ALLOWED_ORIGINS=https://vfreis.github.io,http://localhost:5173

# Optional catalog override. Production normally resolves data/menu.json from the monorepo root.
MENU_CATALOG_PATH=

# Upload / decision guardrails.
MAX_UPLOAD_MB=8
MAX_IMAGE_EDGE=1600
MAX_REFERENCE_IMAGES=8
MATCH_THRESHOLD=0.78
MIN_TOP_MARGIN=0.10
RATE_LIMIT_PER_MINUTE=20

# Hostinger Node.js Web App runtime.
NODE_ENV=production
PORT=3000
